# Airwallex SANDBOX scoped key: Developer > API keys > New scoped key. Copy to .env; never commit .env.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Claude for the agent layer (optional; without it replies come from templates). One of the two:
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Hard cap on model spend in USD, tracked in runs/llm-spend.json
LLM_BUDGET_USD=20
